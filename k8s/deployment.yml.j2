apiVersion: apps/v1
kind: Deployment
metadata:
  name: shop-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: shop
  template:
    metadata:
      labels:
        app: shop
    spec:
      containers:
        - name: shop-container
          image: "{{ image_name }}:{{ image_tag }}"
          imagePullPolicy: Always
          ports:
            - containerPort: 80